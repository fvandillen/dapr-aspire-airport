@page "/atc"
@inject AirportLiveState Live
@implements IDisposable

<PageTitle>ATC Tower</PageTitle>

<div class="page-header">
    <div>
        <h1>ATC Tower</h1>
        <p>Active clearances persisted in the Dapr state store.</p>
    </div>
    <BbButton Variant="ButtonVariant.Outline" OnClick="LoadAsync">
        <LucideIcon Name="refresh-cw" Size="14" /> Refresh
    </BbButton>
</div>

@if (Live.TowerError is not null || Live.TowerWeatherError is not null)
{
    <div class="feed-warning" role="status">@(Live.TowerError ?? Live.TowerWeatherError)</div>
}

<BbCard>
    <BbCardHeader>
        <BbCardTitle>Active runway clearances</BbCardTitle>
        <BbCardDescription>Each entry expires automatically after 15 seconds.</BbCardDescription>
    </BbCardHeader>
    <BbCardContent>
        @if (!_clearances.Any())
        {
            <p class="muted">@(Live.TowerLive ? "No active clearances." : "Waiting for tower clearances. Runway availability is unknown.")</p>
        }
        else
        {
            <table style="width:100%; border-collapse:collapse;">
                <thead>
                    <tr style="text-align:left; border-bottom:1px solid var(--border);">
                        <th style="padding:0.5rem 0;">Callsign</th>
                        <th>Type</th>
                        <th>Runway</th>
                        <th>Granted</th>
                        <th>Expires</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in _clearances)
                    {
                        <tr style="border-bottom:1px solid var(--border);">
                            <td style="padding:0.5rem 0;"><a href="@($"/flight/{Uri.EscapeDataString(c.FlightId)}")"><strong>@c.Callsign</strong></a></td>
                            <td>
                                <BbBadge Variant="@(c.Kind == ClearanceKind.Takeoff ? BadgeVariant.Default : BadgeVariant.Secondary)">
                                    @c.Kind
                                </BbBadge>
                            </td>
                            <td style="font-family:monospace;">@c.Runway</td>
                            <td>@c.GrantedAt.ToLocalTime().ToString("HH:mm:ss")</td>
                            <td>@c.ExpiresAt.ToLocalTime().ToString("HH:mm:ss")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </BbCardContent>
</BbCard>

@if (_lastWeather is not null)
{
    <div style="margin-top:1rem;">
        <BbCard>
            <BbCardHeader>
                <BbCardTitle>Last weather observed by ATC</BbCardTitle>
                <BbCardDescription>
                    ATC subscribes to the same <code>weather-updates</code> topic the WeatherService publishes to.
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <div class="muted">
                    @_lastWeather.Condition · wind @_lastWeather.WindKnots kt · vis @_lastWeather.VisibilityMeters m
                    @if (!_lastWeather.IsFlyable)
                    {
                        <BbBadge Variant="BadgeVariant.Destructive" Class="ml-2">below minima</BbBadge>
                    }
                </div>
            </BbCardContent>
        </BbCard>
    </div>
}

@code {
    private IEnumerable<ActiveClearance> _clearances => Live.ActiveClearances;
    private WeatherSnapshot? _lastWeather => Live.TowerWeather;

    protected override void OnInitialized() => Live.Changed += OnLiveChanged;
    private void OnLiveChanged() => _ = InvokeAsync(StateHasChanged);
    private Task LoadAsync() => Live.RefreshAsync();
    public void Dispose() => Live.Changed -= OnLiveChanged;
}
