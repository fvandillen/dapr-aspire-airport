@page "/"
@inject FlightsApi Flights
@inject AirportLiveState Live
@implements IDisposable

<PageTitle>AMS / Live Airport</PageTitle>

<div class="page-header">
    <div>
        <span class="eyebrow">AIRPORT OVERVIEW</span>
        <h1>Live traffic <span class="heading-count">@(Live.FlightsUpdatedAt is null ? "--" : Live.Flights.Count.ToString())</span></h1>
        <p>Every aircraft. Every stage of the journey.</p>
    </div>
    <button class="scene-tool icon-tool" @onclick="Live.RefreshAsync" aria-label="Refresh flight board" title="Refresh">
        <LucideIcon Name="refresh-cw" Size="16" />
    </button>
</div>

@if (Live.FlightsError is not null)
{
    <div class="feed-warning" role="status">@Live.FlightsError</div>
}
@if (_actionError is not null)
{
    <div class="feed-warning" role="alert">@_actionError</div>
}

<div class="traffic-summary">
    <div><strong>@CountLabel(f => f.Status is not (FlightStatus.Landed or FlightStatus.Cancelled))</strong><span>Active</span></div>
    <div><strong>@CountLabel(f => f.Status is FlightStatus.Landed)</strong><span>Landed</span></div>
    <div><strong>@CountLabel(f => f.Status is FlightStatus.Cancelled)</strong><span>Cancelled</span></div>
</div>

<div class="traffic-actions">
    <button class="workspace-button primary-button" @onclick="SeedAsync" disabled="@_seeding">
        <LucideIcon Name="sparkles" Size="15" /> @(_seeding ? "Scheduling..." : "Seed sample flights")
    </button>
    <a class="workspace-button" href="/operations" title="Schedule a flight"><LucideIcon Name="plus" Size="15" /> New flight</a>
</div>

<label class="traffic-search">
    <LucideIcon Name="search" Size="15" />
    <span class="sr-only">Search flights by callsign, destination, or gate</span>
    <input type="search" @bind="_search" @bind:event="oninput" placeholder="Find a flight, destination, gate..." />
</label>

<div class="traffic-list">
    @if (Live.FlightsUpdatedAt is null)
    {
        <div class="empty-traffic">
            <LucideIcon Name="radio-tower" Size="30" />
            <h2>Connecting to flight operations</h2>
            <p>The airfield is ready. Flights will appear when the service is available.</p>
        </div>
    }
    else if (Live.Flights.Count == 0)
    {
        <div class="empty-traffic">
            <LucideIcon Name="plane-takeoff" Size="34" />
            <h2>Your airfield is ready</h2>
            <p>Seed four sample flights or schedule your own. Watch each workflow move through the airport.</p>
        </div>
    }
    else if (!FilteredFlights.Any())
    {
        <p class="muted empty-traffic">No flights match your search.</p>
    }
    else
    {
        @foreach (var flight in FilteredFlights)
        {
            <a @key="flight.FlightId" href="@($"/flight/{Uri.EscapeDataString(flight.FlightId)}")"
               class="traffic-card @(flight.Status is FlightStatus.Landed or FlightStatus.Cancelled ? "is-complete" : "")"
               aria-label="@($"{flight.Callsign} to {flight.Destination}, {StatusLabel(flight.Status)}. Open flight controls and follow aircraft.")">
                <div class="traffic-card-top">
                    <span class="flight-airline">@flight.Callsign</span>
                    <span class="badge @StatusClass(flight.Status)">@StatusLabel(flight.Status)</span>
                </div>
                <div class="flight-route"><span>@flight.Origin</span><span class="route-line"><LucideIcon Name="plane" Size="15" /></span><span>@flight.Destination</span><LucideIcon Name="arrow-up-right" Size="16" /></div>
                <div class="flight-meta"><span>@flight.ScheduledDeparture.ToLocalTime().ToString("HH:mm")</span><span>Gate <strong>@flight.Gate</strong></span><span>@flight.AircraftType</span></div>
                @if (flight.Runway is not null || !string.IsNullOrWhiteSpace(flight.Note))
                {
                    <div class="flight-note">@(flight.Runway is not null ? $"RWY {flight.Runway} / " : "")@flight.Note</div>
                }
            </a>
        }
    }
</div>

<div class="panel-footnote"><span class="feed-indicator @(Live.FlightsLive ? "is-live" : "")"></span>
    @(Live.FlightsUpdatedAt is { } updated ? $"Snapshot {updated.ToLocalTime():HH:mm:ss} / refreshes every 2s" : "Waiting for first snapshot")
</div>

@code {
    private bool _seeding;
    private string? _actionError;
    private string _search = "";
    private string CountLabel(Func<FlightView, bool> predicate) =>
        Live.FlightsUpdatedAt is null ? "--" : Live.Flights.Count(predicate).ToString();
    private IEnumerable<FlightView> FilteredFlights => Live.Flights.Where(f =>
        f.Callsign.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
        f.Destination.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
        f.Gate.Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override void OnInitialized() => Live.Changed += OnLiveChanged;
    private void OnLiveChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task SeedAsync()
    {
        _seeding = true;
        _actionError = null;
        try
        {
            await Flights.SeedAsync();
            await Live.RefreshAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or OperationCanceledException)
        {
            _actionError = $"Could not seed flights: {ex.Message}";
        }
        finally
        {
            _seeding = false;
        }
    }

    private static string StatusClass(FlightStatus status) => status switch
    {
        FlightStatus.Scheduled => "status-scheduled",
        FlightStatus.WaitingForGate => "status-waitgate",
        FlightStatus.BoardingPushback => "status-boarding",
        FlightStatus.AwaitingTakeoffClearance => "status-cleared",
        FlightStatus.Departed => "status-departed",
        FlightStatus.Cruising => "status-cruising",
        FlightStatus.AwaitingLandingClearance => "status-landing",
        FlightStatus.Landed => "status-landed",
        FlightStatus.Cancelled => "status-cancelled",
        _ => "status-scheduled"
    };

    private static string StatusLabel(FlightStatus status) => status switch
    {
        FlightStatus.WaitingForGate => "WAITING FOR GATE",
        FlightStatus.BoardingPushback => "BOARDING",
        FlightStatus.AwaitingTakeoffClearance => "AWAITING TAKEOFF",
        FlightStatus.AwaitingLandingClearance => "AWAITING LANDING",
        _ => status.ToString().ToUpperInvariant()
    };

    public void Dispose() => Live.Changed -= OnLiveChanged;
}
