@inject IJSRuntime JS
@inject AirportLiveState Live
@inject NavigationManager Nav
@inject ILogger<AirportScene> Logger
@implements IAsyncDisposable

<div class="airport-scene" @ref="_host" aria-label="Interactive 3D airport"></div>
<div class="scene-vignette" aria-hidden="true"></div>

@if (_error is not null)
{
    <div class="scene-fallback" role="alert">
        <LucideIcon Name="monitor" Size="30" />
        <h2>3D view unavailable</h2>
        <p>@_error</p>
        <p>All flight, weather, and tower controls remain available in the operations panel.</p>
        <button class="workspace-button" @onclick="RetryAsync">Retry 3D view</button>
    </div>
}
else if (_scene is null)
{
    <div class="scene-loading" role="status">
        <span class="scene-loading-orbit"></span>
        <span>Preparing the airfield</span>
    </div>
}

<div class="scene-toolbar" aria-label="3D view controls">
    <div class="camera-presets" role="group" aria-label="Camera position">
        @foreach (var view in _views)
        {
            <button class="scene-tool @(_view == view.Id ? "is-active" : "")"
                    aria-pressed="@(_view == view.Id)" disabled="@(!Ready)"
                    @onclick="() => SetViewAsync(view.Id)" title="@view.Label">
                <LucideIcon Name="@view.Icon" Size="16" />
                <span>@view.Label</span>
            </button>
        }
    </div>
    <div class="scene-settings">
        <label>
            <span class="sr-only">Scene lighting (visual only)</span>
            <select aria-label="Scene lighting (visual only)" value="@_lighting" @onchange="SetLightingAsync" disabled="@(!Ready)">
                <option value="dusk">Golden hour</option>
                <option value="day">Daylight</option>
                <option value="night">Night lights</option>
            </select>
        </label>
        <label>
            <span class="sr-only">Graphics quality</span>
            <select aria-label="Graphics quality" value="@_quality" @onchange="SetQualityAsync" disabled="@(!Ready)">
                <option value="high">High fidelity</option>
                <option value="balanced">Balanced</option>
            </select>
        </label>
        <button class="scene-tool icon-tool" @onclick="ToggleMotionAsync" disabled="@(!Ready)"
                aria-label="@(_motion ? "Pause scene motion" : "Enable scene motion")" aria-pressed="@_motion"
                title="@(_motion ? "Pause scene motion" : "Enable scene motion")">
            <LucideIcon Name="@(_motion ? "pause" : "play")" Size="16" />
        </button>
        <button class="scene-tool icon-tool" @onclick="ToggleLabelsAsync" disabled="@(!Ready)"
                aria-label="Aircraft labels" aria-pressed="@_labels" title="Aircraft labels">
            <LucideIcon Name="tags" Size="16" />
        </button>
    </div>
</div>

<div class="scene-help">
    <LucideIcon Name="mouse-pointer-2" Size="13" />
    <span>Drag to orbit · Scroll to zoom · Select an aircraft</span>
    <span class="keyboard-help">Keyboard: arrows orbit · + / - zoom · Home reset</span>
</div>

@code {
    private ElementReference _host;
    private IJSObjectReference? _module;
    private IJSObjectReference? _scene;
    private DotNetObjectReference<AirportScene>? _reference;
    private bool _disposed;
    private Task? _rendering;
    private string? _error;
    private long _revision = -1;
    private string? _selectedFlight;
    private string? _syncedFlight;
    private string _view = "overview";
    private string _lighting = "dusk";
    private string _quality = "high";
    private bool _motion = true;
    private bool _labels = true;
    private bool Ready => _scene is not null && _error is null;
    private readonly (string Id, string Label, string Icon)[] _views =
    [
        ("overview", "Airport", "orbit"),
        ("terminal", "Terminal", "building-2"),
        ("runway", "Runway", "plane-takeoff"),
        ("tower", "Tower", "radio-tower")
    ];

    protected override void OnInitialized()
    {
        Live.Changed += OnLiveChanged;
        Nav.LocationChanged += OnLocationChanged;
        ReadRoute();
    }

    private void OnLiveChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        ReadRoute();
        _ = InvokeAsync(StateHasChanged);
    }

    private void ReadRoute()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0];
        _selectedFlight = path.StartsWith("flight/", StringComparison.OrdinalIgnoreCase)
            ? Uri.UnescapeDataString(path["flight/".Length..]) : null;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (_rendering is { IsCompleted: false })
            return Task.CompletedTask;
        return _rendering = SyncSceneAsync();
    }

    private async Task SyncSceneAsync()
    {
        if (_disposed || _error is not null)
            return;

        try
        {
            if (_scene is null)
            {
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/airport-scene.js");
                if (_disposed) return;
                _reference ??= DotNetObjectReference.Create(this);
                _scene = await _module.InvokeAsync<IJSObjectReference>("createScene", _host, _reference);
                _motion = await _scene.InvokeAsync<bool>("getMotion");
                StateHasChanged();
            }

            if (_revision != Live.Revision)
            {
                var revision = Live.Revision;
                await _scene.InvokeVoidAsync("update", new
                {
                    flights = Live.Flights.Select(f => new
                    {
                        f.FlightId, f.Callsign, f.Origin, f.Destination, f.AircraftType,
                        Status = f.Status.ToString(), f.Gate, f.Runway,
                        f.ScheduledDeparture, f.ActualDeparture, f.ActualArrival
                    }),
                    weather = Live.Weather?.Current,
                    clearances = Live.ActiveClearances.Select(c => new
                    {
                        c.FlightId, c.Callsign, c.Runway, Kind = c.Kind.ToString(), c.ExpiresAt
                    }),
                    flightsAvailable = Live.FlightsLive,
                    weatherAvailable = Live.WeatherLive,
                    clearancesAvailable = Live.TowerLive
                });
                _revision = revision;
            }

            if (_selectedFlight != _syncedFlight)
            {
                var selectedFlight = _selectedFlight;
                await _scene.InvokeVoidAsync("focusFlight", selectedFlight);
                _syncedFlight = selectedFlight;
                _view = selectedFlight is null ? _view : "follow";
                StateHasChanged();
            }
        }
        catch (JSException ex)
        {
            Logger.LogError(ex, "Airport scene could not be rendered");
            _error = "Your browser could not render the airport. Enable WebGL 2 and hardware acceleration, then retry.";
            StateHasChanged();
        }
    }

    private async Task CommandAsync(string method, object? value)
    {
        if (!Ready) return;
        try
        {
            await _scene!.InvokeVoidAsync(method, value);
        }
        catch (JSException ex)
        {
            Logger.LogError(ex, "Airport scene command {Method} failed", method);
            _error = "The 3D view stopped responding. Retry the view; operational controls are unaffected.";
        }
    }

    private async Task SetViewAsync(string view)
    {
        _view = view;
        await CommandAsync("setView", view);
    }

    private async Task SetLightingAsync(ChangeEventArgs args)
    {
        _lighting = args.Value?.ToString() ?? "dusk";
        await CommandAsync("setTimeOfDay", _lighting);
    }

    private async Task SetQualityAsync(ChangeEventArgs args)
    {
        _quality = args.Value?.ToString() ?? "high";
        await CommandAsync("setQuality", _quality);
    }

    private async Task ToggleMotionAsync()
    {
        _motion = !_motion;
        await CommandAsync("setMotion", _motion);
    }

    private async Task ToggleLabelsAsync()
    {
        _labels = !_labels;
        await CommandAsync("setLabels", _labels);
    }

    [JSInvokable]
    public void SelectFlight(string flightId)
    {
        if (!_disposed && Live.Flights.Any(f => f.FlightId == flightId))
            Nav.NavigateTo($"/flight/{Uri.EscapeDataString(flightId)}");
    }

    [JSInvokable]
    public Task SceneUnavailable(string message) => InvokeAsync(() =>
    {
        Logger.LogWarning("Airport renderer unavailable: {Message}", message);
        _error = "The graphics context was lost. Retry the 3D view or continue using the operations panel.";
        StateHasChanged();
    });

    private async Task RetryAsync()
    {
        await ReleaseSceneAsync();
        _revision = -1;
        _syncedFlight = null;
        _view = "overview";
        _lighting = "dusk";
        _quality = "high";
        _labels = true;
        _error = null;
    }

    private async Task ReleaseSceneAsync()
    {
        if (_scene is null) return;
        try
        {
            await _scene.InvokeVoidAsync("dispose");
            await _scene.DisposeAsync();
        }
        catch (JSDisconnectedException ex)
        {
            Logger.LogDebug(ex, "Browser disconnected while releasing the airport scene");
        }
        finally
        {
            _scene = null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Live.Changed -= OnLiveChanged;
        Nav.LocationChanged -= OnLocationChanged;
        if (_rendering is not null)
            await _rendering;
        await ReleaseSceneAsync();
        if (_module is not null)
            await _module.DisposeAsync();
        _reference?.Dispose();
    }
}
